{
  "description": "InternalEvents(type) is the inverse of CanonicalEvent, for filtering stored events by a canonical type: the stored event types that map to it, sorted. A type no stored event maps to gives none, except \"other.<rest>\", which matches <rest> on a best-effort basis.",
  "cases": [
    { "name": "activity.cancelled", "input": { "type": "activity.cancelled" }, "output": ["Cancelled"] },
    { "name": "activity.created", "input": { "type": "activity.created" }, "output": ["Enqueued"] },
    { "name": "activity.priority_changed", "input": { "type": "activity.priority_changed" }, "output": ["PriorityChanged"] },
    { "name": "activity.rescheduled", "input": { "type": "activity.rescheduled" }, "output": ["Rescheduled"] },
    { "name": "activity.retried", "input": { "type": "activity.retried" }, "output": ["Retried"] },
    { "name": "activity.run_now", "input": { "type": "activity.run_now" }, "output": ["RunNow"] },
    { "name": "activity.scheduled", "input": { "type": "activity.scheduled" }, "output": ["Scheduled"] },
    { "name": "attempt.failed", "input": { "type": "attempt.failed" }, "output": ["Failed", "Retrying"] },
    { "name": "attempt.lease_expired", "input": { "type": "attempt.lease_expired" }, "output": ["Requeued"] },
    { "name": "attempt.lease_extended", "input": { "type": "attempt.lease_extended" }, "output": ["LeaseExtended"] },
    { "name": "attempt.started", "input": { "type": "attempt.started" }, "output": ["Dequeued"] },
    { "name": "attempt.succeeded", "input": { "type": "attempt.succeeded" }, "output": ["Completed"] },
    { "name": "child.linked", "input": { "type": "child.linked" }, "output": ["SpawnLinked"] },
    { "name": "dead_letter.entered", "input": { "type": "dead_letter.entered" }, "output": ["DeadLetter"] },
    { "name": "dead_letter.redriven", "input": { "type": "dead_letter.redriven" }, "output": ["Redriven"] },
    { "name": "result.stored", "input": { "type": "result.stored" }, "output": ["ResultStored"] },
    { "name": "signal.received", "input": { "type": "signal.received" }, "output": ["Signaled"] },
    { "name": "wait.parked", "input": { "type": "wait.parked" }, "output": ["Yielded"] },
    { "name": "attempt.timed_out", "input": { "type": "attempt.timed_out" }, "output": [] },
    { "name": "other.customthing", "input": { "type": "other.customthing" }, "output": ["customthing"] },
    { "name": "other.failed", "input": { "type": "other.failed" }, "output": ["failed"] },
    { "name": "not.a.type", "input": { "type": "not.a.type" }, "output": [] }
  ]
}
