{
  "description": "Fire(cron, timezone, next_fire_at, now, catch_up, limit) is what one firing of a due schedule does (schedules.md): `fire` lists the fire times to enqueue, oldest first, and `next_fire_at` is the schedule's next. The due ticks are the cron's fire times t with next_fire_at <= t <= now. 'one' fires the latest due tick; 'skip' fires it only when now - t is less than schedule_catch_up_grace_seconds (constants.json, 60); 'all' fires the latest `limit` due ticks. next_fire_at becomes the first fire time after now. When next_fire_at is after now nothing fires and next_fire_at is unchanged.",
  "cases": [
    { "name": "on time: one fires the tick", "input": { "catch_up": "one", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T00:00:05Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T00:00:00Z"], "next_fire_at": "2026-01-01T01:00:00Z" } },
    { "name": "on time: skip fires the tick", "input": { "catch_up": "skip", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T00:00:05Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T00:00:00Z"], "next_fire_at": "2026-01-01T01:00:00Z" } },
    { "name": "on time: all fires the tick", "input": { "catch_up": "all", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T00:00:05Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T00:00:00Z"], "next_fire_at": "2026-01-01T01:00:00Z" } },
    { "name": "skip: just inside the grace", "input": { "catch_up": "skip", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T00:00:59.999Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T00:00:00Z"], "next_fire_at": "2026-01-01T01:00:00Z" } },
    { "name": "skip: at the grace the tick is missed", "input": { "catch_up": "skip", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T00:01:00Z", "timezone": "UTC" }, "output": { "fire": [], "next_fire_at": "2026-01-01T01:00:00Z" } },
    { "name": "skip: after an outage nothing fires", "input": { "catch_up": "skip", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T05:30:00Z", "timezone": "UTC" }, "output": { "fire": [], "next_fire_at": "2026-01-01T06:00:00Z" } },
    { "name": "skip: after an outage the latest tick fires if on time", "input": { "catch_up": "skip", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T05:00:30Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T05:00:00Z"], "next_fire_at": "2026-01-01T06:00:00Z" } },
    { "name": "one: after an outage the latest tick fires once", "input": { "catch_up": "one", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T05:30:00Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T05:00:00Z"], "next_fire_at": "2026-01-01T06:00:00Z" } },
    { "name": "all: every missed tick, oldest first", "input": { "catch_up": "all", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T05:30:00Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T00:00:00Z", "2026-01-01T01:00:00Z", "2026-01-01T02:00:00Z", "2026-01-01T03:00:00Z", "2026-01-01T04:00:00Z", "2026-01-01T05:00:00Z"], "next_fire_at": "2026-01-01T06:00:00Z" } },
    { "name": "all: the limit keeps the latest ticks", "input": { "catch_up": "all", "cron": "0 * * * *", "limit": 3, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T05:30:00Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T03:00:00Z", "2026-01-01T04:00:00Z", "2026-01-01T05:00:00Z"], "next_fire_at": "2026-01-01T06:00:00Z" } },
    { "name": "all: limit 1", "input": { "catch_up": "all", "cron": "0 * * * *", "limit": 1, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T05:30:00Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T05:00:00Z"], "next_fire_at": "2026-01-01T06:00:00Z" } },
    { "name": "not due yet: nothing changes", "input": { "catch_up": "all", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-01-01T01:00:00Z", "now": "2026-01-01T00:30:00Z", "timezone": "UTC" }, "output": { "fire": [], "next_fire_at": "2026-01-01T01:00:00Z" } },
    { "name": "next_fire_at between ticks: ticks at or after it", "input": { "catch_up": "all", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-01-01T00:30:00Z", "now": "2026-01-01T02:10:00Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T01:00:00Z", "2026-01-01T02:00:00Z"], "next_fire_at": "2026-01-01T03:00:00Z" } },
    { "name": "next_fire_at with a fraction: ticks at or after it", "input": { "catch_up": "all", "cron": "* * * * * *", "limit": 100, "next_fire_at": "2026-01-01T00:00:00.5Z", "now": "2026-01-01T00:00:03Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T00:00:01Z", "2026-01-01T00:00:02Z", "2026-01-01T00:00:03Z"], "next_fire_at": "2026-01-01T00:00:04Z" } },
    { "name": "every second, an hour behind, limited", "input": { "catch_up": "all", "cron": "* * * * * *", "limit": 5, "next_fire_at": "2026-01-01T00:00:00Z", "now": "2026-01-01T01:00:00.25Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T00:59:56Z", "2026-01-01T00:59:57Z", "2026-01-01T00:59:58Z", "2026-01-01T00:59:59Z", "2026-01-01T01:00:00Z"], "next_fire_at": "2026-01-01T01:00:01Z" } },
    { "name": "yearly, five years behind", "input": { "catch_up": "all", "cron": "0 0 1 1 *", "limit": 100, "next_fire_at": "2021-01-01T00:00:00Z", "now": "2026-06-01T00:00:00Z", "timezone": "UTC" }, "output": { "fire": ["2021-01-01T00:00:00Z", "2022-01-01T00:00:00Z", "2023-01-01T00:00:00Z", "2024-01-01T00:00:00Z", "2025-01-01T00:00:00Z", "2026-01-01T00:00:00Z"], "next_fire_at": "2027-01-01T00:00:00Z" } },
    { "name": "yearly, five years behind, one", "input": { "catch_up": "one", "cron": "0 0 1 1 *", "limit": 100, "next_fire_at": "2021-01-01T00:00:00Z", "now": "2026-06-01T00:00:00Z", "timezone": "UTC" }, "output": { "fire": ["2026-01-01T00:00:00Z"], "next_fire_at": "2027-01-01T00:00:00Z" } },
    { "name": "daily in New York across spring forward", "input": { "catch_up": "all", "cron": "30 2 * * *", "limit": 100, "next_fire_at": "2026-03-07T07:30:00Z", "now": "2026-03-10T12:00:00Z", "timezone": "America/New_York" }, "output": { "fire": ["2026-03-07T07:30:00Z", "2026-03-08T07:00:00Z", "2026-03-09T06:30:00Z", "2026-03-10T06:30:00Z"], "next_fire_at": "2026-03-11T06:30:00Z" } },
    { "name": "hourly in New York across fall back", "input": { "catch_up": "all", "cron": "0 * * * *", "limit": 100, "next_fire_at": "2026-11-01T04:00:00Z", "now": "2026-11-01T08:30:00Z", "timezone": "America/New_York" }, "output": { "fire": ["2026-11-01T04:00:00Z", "2026-11-01T05:00:00Z", "2026-11-01T06:00:00Z", "2026-11-01T07:00:00Z", "2026-11-01T08:00:00Z"], "next_fire_at": "2026-11-01T09:00:00Z" } }
  ]
}
