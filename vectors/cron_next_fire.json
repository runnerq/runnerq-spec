{
  "description": "Next(cron, timezone, from) lists the first `count` fire times strictly after `from`, in RFC 3339 UTC, or \"invalid\" when the expression or the time zone is rejected. The dialect and the rules, including daylight-saving changes, are in schedules.md: 5 fields (minute hour day-of-month month day-of-week) or 6 with seconds first; *, values, a-b ranges, /n steps and comma lists; JAN-DEC and SUN-SAT in any case; 0 and 7 are Sunday; @yearly, @annually, @monthly, @weekly, @daily, @midnight and @hourly. When day-of-month and day-of-week both begin with something other than *, a day matches either; otherwise both. Times are wall-clock times in the IANA zone. Where the clock springs forward, a schedule whose hour field does not begin with * fires once at the instant the gap ends for any matching wall time in the gap; others skip the gap. Where the clock falls back, a schedule whose hour field does not begin with * fires only in the first pass through the repeated wall times; others fire in both.",
  "cases": [
    { "name": "every minute", "input": { "count": 3, "cron": "* * * * *", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-01T00:01:00Z", "2026-01-01T00:02:00Z", "2026-01-01T00:03:00Z"] },
    { "name": "from is exclusive and may be mid-second", "input": { "count": 2, "cron": "* * * * *", "from": "2026-01-01T00:00:30.5Z", "timezone": "UTC" }, "output": ["2026-01-01T00:01:00Z", "2026-01-01T00:02:00Z"] },
    { "name": "six fields: seconds first", "input": { "count": 4, "cron": "*/15 * * * * *", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-01T00:00:15Z", "2026-01-01T00:00:30Z", "2026-01-01T00:00:45Z", "2026-01-01T00:01:00Z"] },
    { "name": "six fields: one second past every minute", "input": { "count": 2, "cron": "1 * * * * *", "from": "2026-01-01T00:00:01Z", "timezone": "UTC" }, "output": ["2026-01-01T00:01:01Z", "2026-01-01T00:02:01Z"] },
    { "name": "weekdays at nine, from a Friday", "input": { "count": 3, "cron": "0 9 * * 1-5", "from": "2026-01-02T10:00:00Z", "timezone": "UTC" }, "output": ["2026-01-05T09:00:00Z", "2026-01-06T09:00:00Z", "2026-01-07T09:00:00Z"] },
    { "name": "31st skips shorter months", "input": { "count": 3, "cron": "0 0 31 * *", "from": "2026-01-31T00:00:00Z", "timezone": "UTC" }, "output": ["2026-03-31T00:00:00Z", "2026-05-31T00:00:00Z", "2026-07-31T00:00:00Z"] },
    { "name": "February 29 only in leap years", "input": { "count": 3, "cron": "0 0 29 2 *", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2028-02-29T00:00:00Z", "2032-02-29T00:00:00Z", "2036-02-29T00:00:00Z"] },
    { "name": "2100 is not a leap year", "input": { "count": 1, "cron": "0 0 29 2 *", "from": "2096-03-01T00:00:00Z", "timezone": "UTC" }, "output": ["2104-02-29T00:00:00Z"] },
    { "name": "day of month OR day of week when both are restricted", "input": { "count": 6, "cron": "0 0 13 * 5", "from": "2026-02-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-02-06T00:00:00Z", "2026-02-13T00:00:00Z", "2026-02-20T00:00:00Z", "2026-02-27T00:00:00Z", "2026-03-06T00:00:00Z", "2026-03-13T00:00:00Z"] },
    { "name": "day of month AND day of week when one begins with *", "input": { "count": 3, "cron": "0 0 */2 * 1", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-05T00:00:00Z", "2026-01-19T00:00:00Z", "2026-02-09T00:00:00Z"] },
    { "name": "restricted day of month with month: the OR rule still holds", "input": { "count": 3, "cron": "0 0 30 2 MON", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-02-02T00:00:00Z", "2026-02-09T00:00:00Z", "2026-02-16T00:00:00Z"] },
    { "name": "7 is Sunday", "input": { "count": 2, "cron": "0 12 * * 7", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-04T12:00:00Z", "2026-01-11T12:00:00Z"] },
    { "name": "weekday range through 7", "input": { "count": 4, "cron": "0 0 * * 5-7", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-02T00:00:00Z", "2026-01-03T00:00:00Z", "2026-01-04T00:00:00Z", "2026-01-09T00:00:00Z"] },
    { "name": "month and day names, any case", "input": { "count": 2, "cron": "0 0 1 JAN,jul *", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-07-01T00:00:00Z", "2027-01-01T00:00:00Z"] },
    { "name": "day name range", "input": { "count": 3, "cron": "0 0 * * mon-WED", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-05T00:00:00Z", "2026-01-06T00:00:00Z", "2026-01-07T00:00:00Z"] },
    { "name": "range with step", "input": { "count": 4, "cron": "0 8-18/4 * * *", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-01T08:00:00Z", "2026-01-01T12:00:00Z", "2026-01-01T16:00:00Z", "2026-01-02T08:00:00Z"] },
    { "name": "start with step runs to the field's end", "input": { "count": 4, "cron": "5/20 * * * *", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-01T00:05:00Z", "2026-01-01T00:25:00Z", "2026-01-01T00:45:00Z", "2026-01-01T01:05:00Z"] },
    { "name": "list of ranges and values", "input": { "count": 6, "cron": "0,10-12,58 * * * *", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-01T00:10:00Z", "2026-01-01T00:11:00Z", "2026-01-01T00:12:00Z", "2026-01-01T00:58:00Z", "2026-01-01T01:00:00Z", "2026-01-01T01:10:00Z"] },
    { "name": "leading zero", "input": { "count": 1, "cron": "05 * * * *", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-01T00:05:00Z"] },
    { "name": "year boundary", "input": { "count": 1, "cron": "59 23 31 12 *", "from": "2026-12-31T23:59:00Z", "timezone": "UTC" }, "output": ["2027-12-31T23:59:00Z"] },
    { "name": "@hourly", "input": { "count": 2, "cron": "@hourly", "from": "2026-01-01T00:30:00Z", "timezone": "UTC" }, "output": ["2026-01-01T01:00:00Z", "2026-01-01T02:00:00Z"] },
    { "name": "@daily", "input": { "count": 2, "cron": "@daily", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-02T00:00:00Z", "2026-01-03T00:00:00Z"] },
    { "name": "@midnight", "input": { "count": 1, "cron": "@midnight", "from": "2026-01-01T12:00:00Z", "timezone": "UTC" }, "output": ["2026-01-02T00:00:00Z"] },
    { "name": "@weekly is Sunday midnight", "input": { "count": 2, "cron": "@weekly", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-04T00:00:00Z", "2026-01-11T00:00:00Z"] },
    { "name": "@monthly", "input": { "count": 2, "cron": "@monthly", "from": "2026-01-15T00:00:00Z", "timezone": "UTC" }, "output": ["2026-02-01T00:00:00Z", "2026-03-01T00:00:00Z"] },
    { "name": "@yearly", "input": { "count": 1, "cron": "@yearly", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2027-01-01T00:00:00Z"] },
    { "name": "@annually", "input": { "count": 1, "cron": "@annually", "from": "2026-06-01T00:00:00Z", "timezone": "UTC" }, "output": ["2027-01-01T00:00:00Z"] },
    { "name": "macros ignore case", "input": { "count": 1, "cron": "@DAILY", "from": "2026-01-01T00:00:00Z", "timezone": "UTC" }, "output": ["2026-01-02T00:00:00Z"] },
    { "name": "New York: wall time, standard time", "input": { "count": 2, "cron": "0 9 * * *", "from": "2026-01-01T00:00:00Z", "timezone": "America/New_York" }, "output": ["2026-01-01T14:00:00Z", "2026-01-02T14:00:00Z"] },
    { "name": "New York spring forward: a time in the gap fires once when the gap ends", "input": { "count": 3, "cron": "30 2 * * *", "from": "2026-03-07T12:00:00Z", "timezone": "America/New_York" }, "output": ["2026-03-08T07:00:00Z", "2026-03-09T06:30:00Z", "2026-03-10T06:30:00Z"] },
    { "name": "New York spring forward: every minute of the gap's hour fires once at its end", "input": { "count": 3, "cron": "* 2 * * *", "from": "2026-03-08T06:58:00Z", "timezone": "America/New_York" }, "output": ["2026-03-08T07:00:00Z", "2026-03-09T06:00:00Z", "2026-03-09T06:01:00Z"] },
    { "name": "New York spring forward: a quarter-hourly 2am fires once", "input": { "count": 3, "cron": "*/15 2 * * *", "from": "2026-03-08T06:50:00Z", "timezone": "America/New_York" }, "output": ["2026-03-08T07:00:00Z", "2026-03-09T06:00:00Z", "2026-03-09T06:15:00Z"] },
    { "name": "New York spring forward: hourly keeps real hours", "input": { "count": 4, "cron": "0 * * * *", "from": "2026-03-08T05:30:00Z", "timezone": "America/New_York" }, "output": ["2026-03-08T06:00:00Z", "2026-03-08T07:00:00Z", "2026-03-08T08:00:00Z", "2026-03-08T09:00:00Z"] },
    { "name": "New York spring forward: half-hourly skips the missing wall times", "input": { "count": 3, "cron": "*/30 * * * *", "from": "2026-03-08T06:00:00Z", "timezone": "America/New_York" }, "output": ["2026-03-08T06:30:00Z", "2026-03-08T07:00:00Z", "2026-03-08T07:30:00Z"] },
    { "name": "New York spring forward: a later fixed time is unaffected", "input": { "count": 2, "cron": "30 3 * * *", "from": "2026-03-07T12:00:00Z", "timezone": "America/New_York" }, "output": ["2026-03-08T07:30:00Z", "2026-03-09T07:30:00Z"] },
    { "name": "New York fall back: a fixed time in the repeated hour fires once", "input": { "count": 2, "cron": "30 1 * * *", "from": "2026-10-31T12:00:00Z", "timezone": "America/New_York" }, "output": ["2026-11-01T05:30:00Z", "2026-11-02T06:30:00Z"] },
    { "name": "New York fall back: hourly fires in both passes", "input": { "count": 4, "cron": "0 * * * *", "from": "2026-11-01T04:30:00Z", "timezone": "America/New_York" }, "output": ["2026-11-01T05:00:00Z", "2026-11-01T06:00:00Z", "2026-11-01T07:00:00Z", "2026-11-01T08:00:00Z"] },
    { "name": "New York fall back: fixed hour with minute steps skips the second pass", "input": { "count": 3, "cron": "*/20 1 * * *", "from": "2026-11-01T05:30:00Z", "timezone": "America/New_York" }, "output": ["2026-11-01T05:40:00Z", "2026-11-02T06:00:00Z", "2026-11-02T06:20:00Z"] },
    { "name": "New York fall back: from inside the second pass, a fixed time waits for the next day", "input": { "count": 1, "cron": "45 1 * * *", "from": "2026-11-01T06:10:00Z", "timezone": "America/New_York" }, "output": ["2026-11-02T06:45:00Z"] },
    { "name": "New York fall back: from inside the second pass, hourly fires in it", "input": { "count": 2, "cron": "45 * * * *", "from": "2026-11-01T06:10:00Z", "timezone": "America/New_York" }, "output": ["2026-11-01T06:45:00Z", "2026-11-01T07:45:00Z"] },
    { "name": "London spring forward: fires when the gap ends", "input": { "count": 2, "cron": "30 1 * * *", "from": "2026-03-28T12:00:00Z", "timezone": "Europe/London" }, "output": ["2026-03-29T01:00:00Z", "2026-03-30T00:30:00Z"] },
    { "name": "London fall back: a fixed time fires once", "input": { "count": 2, "cron": "30 1 * * *", "from": "2026-10-24T12:00:00Z", "timezone": "Europe/London" }, "output": ["2026-10-25T00:30:00Z", "2026-10-26T01:30:00Z"] },
    { "name": "London fall back: hourly fires in both passes", "input": { "count": 3, "cron": "0 * * * *", "from": "2026-10-24T23:30:00Z", "timezone": "Europe/London" }, "output": ["2026-10-25T00:00:00Z", "2026-10-25T01:00:00Z", "2026-10-25T02:00:00Z"] },
    { "name": "London fall back: every 30 minutes through the repeated hour", "input": { "count": 5, "cron": "0,30 * * * *", "from": "2026-10-25T00:15:00Z", "timezone": "Europe/London" }, "output": ["2026-10-25T00:30:00Z", "2026-10-25T01:00:00Z", "2026-10-25T01:30:00Z", "2026-10-25T02:00:00Z", "2026-10-25T02:30:00Z"] },
    { "name": "Sydney spring forward (October)", "input": { "count": 2, "cron": "30 2 * * *", "from": "2026-10-03T00:00:00Z", "timezone": "Australia/Sydney" }, "output": ["2026-10-03T16:00:00Z", "2026-10-04T15:30:00Z"] },
    { "name": "Lord Howe half-hour shift", "input": { "count": 2, "cron": "15 2 * * *", "from": "2026-10-03T00:00:00Z", "timezone": "Australia/Lord_Howe" }, "output": ["2026-10-03T15:30:00Z", "2026-10-04T15:15:00Z"] },
    { "name": "Kolkata half-hour offset, no DST", "input": { "count": 1, "cron": "0 9 * * *", "from": "2026-01-01T00:00:00Z", "timezone": "Asia/Kolkata" }, "output": ["2026-01-01T03:30:00Z"] },
    { "name": "New York weekly Sunday 2:30 across spring forward", "input": { "count": 2, "cron": "30 2 * * 0", "from": "2026-03-01T12:00:00Z", "timezone": "America/New_York" }, "output": ["2026-03-08T07:00:00Z", "2026-03-15T06:30:00Z"] },
