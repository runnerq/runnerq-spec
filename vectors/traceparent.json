{
  "description": "StoredTraceparent(explicit, active, inherited) is the traceparent an enqueue stores in the activity's metadata (observability/tracing.json metadata_key), or null to store none. explicit is the value the caller put in the metadata itself; active is the traceparent of the tracer's current span at the enqueue (the enqueue span when a tracer is set), null without one; inherited is the stored traceparent of the activity whose handler is enqueueing, null outside a handler. The first that applies wins: a non-null explicit value is kept exactly as given; then active if it is valid; then inherited if it is valid; otherwise null. Valid is the W3C trace context traceparent: lowercase hex fields joined by '-': a 2-digit version other than ff, a 32-digit trace id not all zeros, a 16-digit parent id not all zeros and 2-digit flags. Version 00 is exactly those 55 characters; a later version may continue after a '-' at position 55. So a child enqueued without a tracer inherits its parent's traceparent unchanged, and every activity of a tree keeps the root's trace id.",
  "cases": [
    { "name": "nothing stores nothing", "input": { "active": null, "explicit": null, "inherited": null }, "output": null },
    { "name": "active span", "input": { "active": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "explicit": null, "inherited": null }, "output": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01" },
    { "name": "active wins over inherited", "input": { "active": "00-4bf92f3577b34da6a3ce929d0e0e4736-b7ad6b7169203331-01", "explicit": null, "inherited": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01" }, "output": "00-4bf92f3577b34da6a3ce929d0e0e4736-b7ad6b7169203331-01" },
    { "name": "inherited without a tracer", "input": { "active": null, "explicit": null, "inherited": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00" }, "output": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00" },
    { "name": "explicit wins", "input": { "active": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "explicit": "00-0af7651916cd43dd8448eb211c80319c-b9c7c989f97918e1-01", "inherited": null }, "output": "00-0af7651916cd43dd8448eb211c80319c-b9c7c989f97918e1-01" },
    { "name": "explicit is kept as given", "input": { "active": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "explicit": "not a traceparent", "inherited": null }, "output": "not a traceparent" },
    { "name": "invalid active falls back to inherited", "input": { "active": "00-00000000000000000000000000000000-00f067aa0ba902b7-01", "explicit": null, "inherited": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01" }, "output": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01" },
    { "name": "zero parent id is invalid", "input": { "active": null, "explicit": null, "inherited": "00-4bf92f3577b34da6a3ce929d0e0e4736-0000000000000000-01" }, "output": null },
    { "name": "uppercase is invalid", "input": { "active": null, "explicit": null, "inherited": "00-4BF92F3577B34DA6A3CE929D0E0E4736-00F067AA0BA902B7-01" }, "output": null },
    { "name": "version ff is invalid", "input": { "active": null, "explicit": null, "inherited": "ff-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01" }, "output": null },
    { "name": "version 00 has no extra fields", "input": { "active": null, "explicit": null, "inherited": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01-extra" }, "output": null },
    { "name": "a later version may add fields", "input": { "active": null, "explicit": null, "inherited": "01-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01-extra" }, "output": "01-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01-extra" },
    { "name": "short trace id is invalid", "input": { "active": null, "explicit": null, "inherited": "00-4bf92f3577b34da6a3ce929d0e0e473-00f067aa0ba902b7-01" }, "output": null },
    { "name": "empty is invalid", "input": { "active": "", "explicit": null, "inherited": "" }, "output": null }
  ]
}
