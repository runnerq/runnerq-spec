{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/runnerq/runnerq-spec/protocol/storage/storage.schema.json",
  "title": "RunnerQ storage protocol, version 1",
  "description": "Storage operations a worker's adapter calls on the data plane: POST /v1/queues/{queue}/{operation} with RunnerQ-Storage-Version: 1. See README.md. String lengths are UTF-8 bytes. A nullable field may be absent; absent and null mean the same. Required lists what a Go encoder always sends.",
  "x-version": 1,
  "$defs": {
    "UUID": {
      "description": "A UUID, lowercase in the 8-4-4-4-12 form. Absent or null decodes as the nil UUID.",
      "type": "string",
      "format": "uuid",
      "x-go-type": "uuid.UUID"
    },
    "Timestamp": {
      "description": "RFC 3339 with up to nanosecond precision (Go's time.RFC3339Nano). The zero time is 0001-01-01T00:00:00Z.",
      "type": "string",
      "format": "date-time",
      "x-go-type": "time.Time"
    },
    "Duration": {
      "description": "A duration in integer nanoseconds.",
      "type": "integer",
      "x-go-type": "time.Duration"
    },
    "RawJSON": {
      "description": "Any JSON value, carried as is: a payload, result or detail. Absent and null are the same.",
      "x-go-type": "json.RawMessage"
    },
    "Priority": {
      "description": "1 low, 2 normal, 3 high, 4 critical.",
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ],
      "x-go-type": "storage.ActivityPriority"
    },
    "IdempotencyBehavior": {
      "description": "0 allow reuse, 1 return existing, 2 allow reuse on failure, 3 no reuse.",
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ],
      "x-go-type": "storage.IdempotencyBehavior"
    },
    "ResultState": {
      "description": "0 ok, 1 error.",
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "x-go-type": "storage.ResultState"
    },
    "ErrorCode": {
      "description": "A storage error kind's name (constants.json storage_error_kind). Clients decode the code, not the HTTP status; an unknown code is a configuration error.",
      "type": "string",
      "enum": [
        "unavailable",
        "conflict",
        "not_found",
        "internal",
        "serialization",
        "configuration",
        "timeout",
        "duplicate_activity",
        "idempotency_conflict",
        "claim_lost",
        "checkpoint_conflict",
        "invalid_argument",
        "unsupported"
      ]
    },
    "ErrorBody": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "field": {
          "description": "The input an invalid_argument or unsupported error is about.",
          "type": "string",
          "x-omitempty": true
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "ResponseBody": {
      "description": "Every response body: result on success (HTTP 200), error otherwise. Operations without a result return null.",
