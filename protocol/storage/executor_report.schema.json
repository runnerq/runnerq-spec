{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/runnerq/runnerq-spec/protocol/storage/executor_report.schema.json",
  "title": "RunnerQ executor report, version 1",
  "description": "A hosted worker's heartbeat: PUT /v1/executors/{id} with the store key, every 10 seconds and (at most every 2 seconds) when it changes; DELETE /v1/executors/{id} on a clean stop. The body is at most 64 KiB; unknown fields are dropped. The sdk and executor parts are the conductor hello's, state is its executor.report. Timestamps are RFC 3339 UTC with millisecond precision.",
  "x-version": 1,
  "$ref": "#/$defs/ExecutorReport",
  "$defs": {
    "ExecutorReport": {
      "type": "object",
      "properties": {
        "sdk": {
          "$ref": "#/$defs/SDKInfo"
        },
        "executor": {
          "$ref": "#/$defs/ExecutorInfo"
        },
        "state": {
          "$ref": "#/$defs/ExecutorState"
        }
      },
      "required": [
        "sdk",
        "executor",
        "state"
      ],
      "additionalProperties": false
    },
    "SDKInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "language"
      ],
      "additionalProperties": false
    },
    "ExecutorInfo": {
      "type": "object",
      "description": "Who the executor is.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable for the process."
        },
        "hostname": {
          "type": "string",
          "x-omitempty": true
        },
        "queues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-omitempty": true,
          "description": "Exactly one, on the data plane."
        },
        "activity_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-omitempty": true
        },
        "max_concurrency": {
          "type": "integer",
          "x-go-type": "int",
          "minimum": 0,
          "x-omitempty": true
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "x-omitempty": true
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "x-omitempty": true
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "ExecutorState": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Empty or the executor's id."
        },
        "uptime_ms": {
          "type": "integer",
          "x-go-type": "int64",
          "minimum": 0,
          "x-go-name": "UptimeMS"
        },
        "max_concurrency": {
          "type": "integer",
          "x-go-type": "int",
          "minimum": 0
        },
        "in_flight": {
          "type": "integer",
          "x-go-type": "int",
          "minimum": 0
        },
        "running": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunningActivity"
          },
          "x-omitempty": true
        },
        "claim_lag_ms": {
          "type": "integer",
          "x-go-type": "int64",
          "minimum": 0,
          "x-go-name": "ClaimLagMS"
        },
        "heartbeat_failures": {
          "type": "integer",
          "minimum": 0,
          "x-go-type": "uint64"
        },
        "draining": {
          "type": "boolean"
        },
        "counters": {
          "$ref": "#/$defs/Counters",
          "x-go-pointer": true,
          "x-omitempty": true
        }
      },
      "required": [
        "id",
        "uptime_ms",
        "max_concurrency",
        "in_flight",
        "claim_lag_ms",
        "heartbeat_failures",
        "draining"
      ],
      "additionalProperties": false
    },
    "RunningActivity": {
      "type": "object",
      "properties": {
        "activity_id": {
          "type": "string",
          "x-go-name": "ActivityID"
        },
        "type": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "x-go-type": "int",
          "minimum": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "activity_id",
        "type",
        "attempt",
        "started_at"
      ],
      "additionalProperties": false
    },
    "Counters": {
      "type": "object",
      "description": "Activity outcomes since the executor started.",
      "properties": {
        "claimed": {
          "type": "integer",
          "minimum": 0,
          "x-go-type": "uint64"
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0,
          "x-go-type": "uint64"
        },
        "retried": {
          "type": "integer",
          "minimum": 0,
          "x-go-type": "uint64"
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "x-go-type": "uint64"
        },
        "timed_out": {
          "type": "integer",
          "minimum": 0,
          "x-go-type": "uint64"
        },
        "dead_lettered": {
          "type": "integer",
          "minimum": 0,
          "x-go-type": "uint64"
        },
        "claims_lost": {
          "type": "integer",
          "minimum": 0,
          "x-go-type": "uint64"
        }
      },
      "required": [
        "claimed",
        "succeeded",
        "retried",
        "failed",
        "timed_out",
        "dead_lettered",
        "claims_lost"
      ],
      "additionalProperties": false
    }
  }
}
