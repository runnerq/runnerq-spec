{
  "description": "A child takes its root's version at insert, whatever version the spawner passes, down the whole tree; a child of an unstamped root stays unstamped.",
  "steps": [
    {
      "op": "submit",
      "as": "r",
      "type": "parent",
      "version": "A"
    },
    {
      "op": "claim",
      "types": [
        "parent"
      ],
      "versions": [
        "A"
      ],
      "as": [
        "cr"
      ],
      "limit": 1,
      "expect": {
        "claims": [
          "r"
        ]
      }
    },
    {
      "op": "submit",
      "as": "k",
      "type": "child",
      "version": "B",
      "parent": "r",
      "root": "r",
      "depth": 1,
      "fence": "cr"
    },
    {
      "op": "submit",
      "as": "k2",
      "type": "child",
      "parent": "r",
      "root": "r",
      "depth": 1,
      "fence": "cr"
    },
    {
      "expect_row": {
        "activity": "k",
        "code_version": "A"
      }
    },
    {
      "expect_row": {
        "activity": "k2",
        "code_version": "A"
      }
    },
    {
      "op": "claim",
      "types": [
        "child"
      ],
      "versions": [
        "B"
      ],
      "limit": 5,
      "expect": {
        "claims": []
      }
    },
    {
      "op": "claim",
      "types": [
        "child"
      ],
      "versions": [
        "A"
      ],
      "as": [
        "ck"
      ],
      "limit": 1,
      "expect": {
        "claims": [
          "k"
        ]
      }
    },
    {
      "op": "submit",
      "as": "g",
      "type": "grandchild",
      "version": "C",
      "parent": "k",
      "root": "r",
      "depth": 2,
      "fence": "ck"
    },
    {
      "expect_row": {
        "activity": "g",
        "code_version": "A"
      }
    },
    {
      "op": "submit",
      "as": "ur",
      "type": "parent"
    },
    {
      "op": "claim",
      "types": [
        "parent"
      ],
      "versions": [
        "B"
      ],
      "as": [
        "cur"
      ],
      "limit": 1,
      "expect": {
        "claims": [
          "ur"
        ]
      }
    },
    {
      "op": "submit",
      "as": "uk",
      "type": "child",
      "version": "B",
      "parent": "ur",
      "root": "ur",
      "depth": 1,
      "fence": "cur"
    },
    {
      "expect_row": {
        "activity": "uk",
        "code_version": {
          "$null": true
        }
      }
    }
  ]
}
