{
  "description": "Version pinning holds across a mixed fleet: Go stamps, a TypeScript worker at another version can't claim, one at the same version can; a child TypeScript spawns takes the Go root's version; a repin from Go replays from TypeScript and moves the work to TypeScript workers at the new version.",
  "steps": [
    {
      "op": "submit",
      "as": "r",
      "type": "parent",
      "version": "A",
      "by": "go"
    },
    {
      "op": "claim",
      "types": [
        "parent"
      ],
      "by": "ts",
      "versions": [
        "B"
      ],
      "limit": 5,
      "expect": {
        "claims": []
      }
    },
    {
      "op": "claim",
      "types": [
        "parent"
      ],
      "by": "ts",
      "versions": [
        "A"
      ],
      "as": [
        "cr"
      ],
      "limit": 1,
      "expect": {
        "claims": [
          "r"
        ]
      }
    },
    {
      "op": "submit",
      "as": "k",
      "type": "child",
      "version": "B",
      "parent": "r",
      "root": "r",
      "depth": 1,
      "fence": "cr",
      "by": "ts"
    },
    {
      "expect_row": {
        "activity": "k",
        "code_version": "A"
      }
    },
    {
      "op": "claim",
      "types": [
        "child"
      ],
      "by": "go",
      "versions": [
        "B"
      ],
      "limit": 5,
      "expect": {
        "claims": []
      }
    },
    {
      "op": "command",
      "by": "go",
      "kind": "repin",
      "command_id": "mixed-repin",
      "ids": [
        "k"
      ],
      "version": "B",
      "expect": {
        "applied": 1,
        "replayed": false
      }
    },
    {
      "op": "command",
      "by": "ts",
      "kind": "repin",
      "command_id": "mixed-repin",
      "ids": [
        "k"
      ],
      "version": "B",
      "expect": {
        "applied": 1,
        "replayed": true
      }
    },
    {
      "op": "claim",
      "types": [
        "child"
      ],
      "by": "ts",
      "versions": [
        "A"
      ],
      "limit": 5,
      "expect": {
        "claims": []
      }
    },
    {
      "op": "claim",
      "types": [
        "child"
      ],
      "by": "ts",
      "versions": [
        "B"
      ],
      "as": [
        "ck"
      ],
      "limit": 1,
      "expect": {
        "claims": [
          "k"
        ]
      }
    },
    {
      "op": "upsert_schedule",
      "by": "ts",
      "name": "tick",
      "cron": "0 * * * *",
      "type": "tick",
      "version": "B"
    },
    {
      "make_schedule_due": "tick",
      "trunc": "hour",
      "back": "0 hours"
    },
    {
      "op": "fire_schedules",
      "by": "go",
      "expect": {
        "count": 1
      }
    },
    {
      "expect_fires": {
        "schedule": "tick",
        "type": "tick",
        "trunc": "hour",
        "ago": [
          "0 hours"
        ],
        "row": {
          "code_version": "B"
        }
      }
    }
  ]
}
