{
  "description": "Malformed commands are rejected whole: no target, both ids and a filter, a filter without max, reschedule without a time, an out-of-range priority, a signal without a name, a repin without a version or with one over 256 bytes.",
  "steps": [
    {
      "op": "submit",
      "as": "a",
      "type": "t"
    },
    {
      "op": "command",
      "kind": "cancel",
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "op": "command",
      "kind": "cancel",
      "ids": [
        "a"
      ],
      "filter": {
        "field": "type",
        "op": "eq",
        "value": "t"
      },
      "max": 1,
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "op": "command",
      "kind": "cancel",
      "filter": {
        "field": "type",
        "op": "eq",
        "value": "t"
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "op": "command",
      "kind": "reschedule",
      "ids": [
        "a"
      ],
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "op": "command",
      "kind": "set_priority",
      "ids": [
        "a"
      ],
      "priority": 9,
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "op": "command",
      "kind": "signal",
      "ids": [
        "a"
      ],
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "op": "command",
      "kind": "repin",
      "ids": [
        "a"
      ],
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "op": "command",
      "kind": "repin",
      "ids": [
        "a"
      ],
      "version": "vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv",
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "expect_row": {
        "activity": "a",
        "status": "pending",
        "priority": 2,
        "code_version": {
          "$null": true
        }
      }
    }
  ]
}
