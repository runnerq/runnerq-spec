{
  "description": "A signal command stores the signal for every unfinished activity, wakes a waiting one, and skips finished ones.",
  "steps": [
    {
      "each_status": {
        "prefix": "s_"
      }
    },
    {
      "op": "command",
      "kind": "signal",
      "command_id": "cmd-1",
      "fingerprint": "f1",
