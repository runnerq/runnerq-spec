        "s_pending",
        "s_scheduled",
        "s_retrying",
        "s_running",
        "s_waiting",
        "s_completed",
        "s_failed",
        "s_dead_letter",
        "s_cancelled",
        "ghost"
      ],
      "name": "nudge",
      "payload": {
        "n": 1
      },
      "expect": {
        "matched": 9,
        "applied": 5,
        "replayed": false,
