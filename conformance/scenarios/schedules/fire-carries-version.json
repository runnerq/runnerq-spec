{
  "description": "A schedule's version is stored in its options at upsert, and its fires and triggers are stamped with it whichever worker fires them; a schedule upserted without a version fires unstamped work.",
  "steps": [
    {
      "op": "upsert_schedule",
      "name": "pinned",
      "cron": "0 * * * *",
      "type": "tp",
      "priority": 3,
      "max_attempts": 4,
      "timeout_s": 60,
      "metadata": {
        "k": "v"
      },
      "version": "A"
    },
    {
      "op": "upsert_schedule",
      "name": "plain",
      "cron": "0 * * * *",
      "type": "tu"
    },
    {
      "expect_schedule": {
        "name": "pinned",
        "options": {
          "priority": 3,
          "max_retries": 4,
          "timeout_seconds": 60,
          "retry_delay_seconds": 1,
          "max_retry_delay_seconds": 0,
          "metadata": {
            "k": "v"
          },
          "code_version": "A"
        }
      }
    },
    {
      "make_schedule_due": "pinned",
      "trunc": "hour",
      "back": "0 hours"
    },
    {
      "make_schedule_due": "plain",
      "trunc": "hour",
      "back": "0 hours"
    },
    {
      "op": "fire_schedules",
      "expect": {
        "count": 2
      }
    },
    {
      "expect_fires": {
        "schedule": "pinned",
        "type": "tp",
        "trunc": "hour",
        "ago": [
          "0 hours"
        ],
        "row": {
          "code_version": "A",
          "priority": 3
        }
      }
    },
    {
      "expect_fires": {
        "schedule": "plain",
        "type": "tu",
        "trunc": "hour",
        "ago": [
          "0 hours"
        ],
        "row": {
          "code_version": {
            "$null": true
          }
        }
      }
    },
    {
      "op": "trigger_schedule",
      "name": "pinned",
      "as": "t"
    },
    {
      "expect_row": {
        "activity": "t",
        "code_version": "A"
      }
    },
    {
      "op": "claim",
      "types": [
        "tp"
      ],
      "versions": [
        "B"
      ],
      "limit": 5,
      "expect": {
        "claims": []
      }
    }
  ]
}
