{
  "description": "catch_up all fires every due tick, oldest first.",
  "steps": [
    {
      "op": "upsert_schedule",
      "name": "s",
      "cron": "0 0 1 1 *",
      "type": "t",
      "catch_up": "all"
    },
    {
      "make_schedule_due": "s",
      "trunc": "year",
      "back": "2 years"
    },
    {
      "op": "fire_schedules",
      "expect": {
        "count": 3
      }
    },
    {
      "expect_fires": {
        "schedule": "s",
        "type": "t",
        "trunc": "year",
        "ago": [
          "2 years",
          "1 year",
          "0 years"
        ]
      }
    },
    {
      "expect_schedule": {
        "name": "s",
        "next_fire_at": {
          "$future": true
        },
        "last_fire_at": {
          "$trunc": [
            "year",
            "0 years"
          ]
        }
      }
    }
  ]
}
