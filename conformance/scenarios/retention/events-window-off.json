{
  "description": "Without an events window, events stay as long as their tree.",
  "steps": [
    {
      "op": "submit",
      "as": "a",
      "type": "t",
      "max_attempts": 1
    },
    {
      "op": "claim",
      "types": [
        "t"
      ],
      "as": [
        "c"
      ],
      "expect": {
        "claims": [
          "a"
        ]
      }
    },
    {
      "op": "fail",
      "claim": "c",
      "reason": "x",
      "retryable": false,
      "expect": {
        "outcome": "failed"
      }
    },
    {
      "backdate_events": "a",
      "seconds": 86400
    },
    {
      "op": "cleanup",
      "completed_s": 3600,
      "failed_s": 172800,
      "batch": 100,
      "expect": {
        "count": 0
      }
    },
    {
      "expect_events": {
        "activity": "a",
        "types": [
          "Failed"
        ]
      }
    }
  ]
}
