{
  "description": "A child that will be retried has no result yet, so its waiting parent stays parked.",
  "steps": [
    {
      "op": "submit",
      "as": "k",
      "type": "child",
      "max_attempts": 3
    },
    {
      "op": "submit",
      "as": "p",
      "type": "parent"
    },
    {
      "op": "claim",
      "types": [
        "parent"
      ],
      "as": [
        "cp"
      ],
      "limit": 1,
      "expect": {
        "claims": [
          "p"
        ]
      }
    },
    {
      "op": "register_dependency",
      "claim": "cp",
      "producer": "k"
    },
    {
      "op": "park",
      "claim": "cp",
      "kind": "await",
      "step": "child:k",
      "wake_in_s": 3600,
      "result_id": "k",
      "producer": "k"
    },
    {
      "op": "claim",
      "types": [
        "child"
      ],
      "as": [
        "ck"
      ],
      "limit": 1,
      "expect": {
        "claims": [
          "k"
        ]
      }
    },
    {
      "op": "fail",
      "claim": "ck",
      "reason": "later",
      "retryable": true,
      "expect": {
        "outcome": "retrying"
      }
    },
    {
      "expect_row": {
        "activity": "p",
        "status": "waiting"
      }
    },
    {
      "expect_result": {
        "id": "k",
        "absent": true
      }
    }
  ]
}
